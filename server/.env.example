PORT=5001
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5001
TELEGRAM_BOT_TOKEN=your_botfather_bot_token
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,your-domain.example

# Leave blank until the CMS has imported the handoff and its JSON API is available.
# Test: http://site-api.dev.vortex-services.com/api
# Production: https://site-api.director.vortex-services.com/api
CMS_API_BASE_URL=
# Optional separate blog API; defaults to CMS_API_BASE_URL when configured.
BLOG_API_BASE_URL=
# Director lead/ticket intake for site requests (POST {DIRECTOR_SITE_API}/forms/submit).
# Defaults to CMS_API_BASE_URL because Director serves both from the same API root.
DIRECTOR_SITE_API=
# 64 hex characters, delivered separately; test and prod secrets differ.
# Keep it only in the server env: never commit it, log it or expose it as VITE_*.
# When empty, requests still reach Telegram and the Director call is skipped.
DIRECTOR_FORM_SECRET=
# Published CMS revision revalidation is 15 seconds; preview sessions last 15 minutes.
# Real CMS data disables the server demo fallback automatically.
BLOG_DEMO_MODE=false
